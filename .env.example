PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=replace_with_a_long_random_secret

# Discord OAuth app (add BASE_URL/auth/discord/callback as its redirect URL)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Comma-separated Discord role IDs; put Moderator roles in STAFF roles.
DISCORD_STAFF_ROLE_IDS=
DISCORD_COMMAND_ROLE_IDS=
DISCORD_ADMIN_ROLE_IDS=
DISCORD_OWNER_ROLE_IDS=
# Roles the management portal may assign/remove from its Promotions page.
DISCORD_ASSIGNABLE_ROLE_IDS=

# Optional ER:LC API Pack key and authentic ER:LC map asset.
ERLC_SERVER_KEY=
ERLC_MAP_IMAGE_URL=https://api.policeroleplay.community/maps/fall_blank.png
ERLC_WORLD_MIN_X=-3000
ERLC_WORLD_MAX_X=3000
ERLC_WORLD_MIN_Z=-3000
ERLC_WORLD_MAX_Z=3000

# Optional Roblox OAuth app (scopes: openid profile)
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=

# Optional OpenAI API assistant. Leave the key blank to use the local helper.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
